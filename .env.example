# Higgsfield API credentials. Server-side only — never commit real values.
# Format: <key-id>:<key-secret>. Create them at https://console.higgsfield.ai
HF_CREDENTIALS=key-id:key-secret

# Identity/tenant attached to every tracked request. In a real backend this
# would be the authenticated user's ID; locally it just groups your requests.
HF_OWNER=local-dev

# Optional overrides
# HF_BASE_URL=https://api.higgsfield.ai
# HF_STATE_DIR=.tmp/higgsfield
# HF_OUT_DIR=.tmp/higgsfield/output
# HF_WEBHOOK_URL=https://example.com/webhooks/higgsfield
# HF_WEBHOOK_SECRET=change-me
