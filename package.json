{
  "name": "trainerApp",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "higgsfield": "node --import tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test prototype/tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc --project tsconfig.e2e.json --noEmit",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:report": "playwright show-report output/playwright/report --host 127.0.0.1",
    "test:prototype": "npm run test:unit && npm run test:e2e"
  },
  "private": true,
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "dotenv": "^18.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
